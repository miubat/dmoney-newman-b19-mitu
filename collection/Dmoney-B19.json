									"// Random Number\r",
									"const randomNumber = lodash.random(1000, 9999);\r",
									"\r",
									"// Email\r",
									"const email = \"sanzidak59+customer1+b19+\" + randomNumber + \"@gmail.com\";\r",
									"\r",
									"// Phone Number (11 digits)\r",
									"const mobile_prefix = \"017\";\r",
									"const randomDigits = lodash.random(10000000, 99999999);\r",
									"const phoneNumber = mobile_prefix + randomDigits;\r",
									"\r",
									"// Save Collection Variables\r",
									"pm.collectionVariables.set(\"customer1Email\", email);\r",
									"pm.collectionVariables.set(\"customer1Phone\", phoneNumber);"
								],
